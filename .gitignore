# Ignore Python bytecode files
__pycache__/
*.py[cod]

# Ignore environment files
env/
venv/
*.env

# Ignore database files
db.sqlite3
*.sqlite3

# Ignore IDE/editor-specific files
.vscode/
.idea/
*.swp

# Ignore compiled files
*.pyc

# Ignore only compiled migration files, but keep actual migrations
*/migrations/*.pyc
*/migrations/__pycache__/

# Ignore media files
/media/


# Python 虚拟环境
.venv/
venv/
env/
ENV/

# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class

# Django 本地配置和敏感信息
.env
.env.*
!.env.example

# Django 日志
*.log

# 测试和覆盖率缓存
.pytest_cache/
.coverage
htmlcov/

# VS Code 本地配置（如需共享工作区配置，可删除此项）
.vscode/

# 操作系统生成的文件
.DS_Store
Thumbs.db
desktop.ini

# 本地数据库文件
db.sqlite3

# 临时文件
*.tmp
*.bak

# Django settings
settings.py